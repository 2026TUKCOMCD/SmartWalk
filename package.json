{
  "name": "smartwalker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd docker && docker-compose up -d postgres redis && cd ../backend && mvnw.cmd spring-boot:run",

    "docker:up": "cd docker && docker-compose up -d postgres redis",
    "docker:dev": "cd docker && docker-compose --profile dev up -d",
    "docker:full": "cd docker && docker-compose --profile full up -d",
    "docker:setup": "cd docker && docker-compose --profile setup up osrm-download osrm-prepare",
    "docker:down": "cd docker && docker-compose down",
    "docker:logs": "cd docker && docker-compose logs -f",

    "backend:dev": "cd backend && mvnw.cmd spring-boot:run",
    "backend:build": "cd backend && mvnw.cmd package -DskipTests",
    "backend:test": "cd backend && mvnw.cmd test",

    "android:dev": "cd android && gradlew.bat installDebug",
    "android:prod": "cd android && gradlew.bat installRelease",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:build:prod": "cd android && gradlew.bat assembleRelease"
  }
}
