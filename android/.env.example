# NavBlind 앱 환경 설정 예시
# 복사 후 값 수정: cp .env.example .env

# 서버 호스트
# 에뮬레이터:            SERVER_HOST=10.0.2.2
# 실기기 (Tailscale):   SERVER_HOST=100.122.72.41
SERVER_HOST=10.0.2.2

# 카메라 소스
# true  → 스마트폰 내장 카메라 (LocalCameraSource)
# false → ESP32-CAM / mock_stream (MjpegCameraSource)
USE_LOCAL_CAMERA=false

# Kakao Maps SDK Native App Key (지도 표시용)
# 백엔드의 KAKAO_API_KEY(REST 키)와는 다른 키 — Kakao Developers 콘솔에서
# 같은 앱의 "Native App Key"를 사용하고, Android 플랫폼에 패키지명(com.smartwalker)과
# 키해시(디버그/릴리즈)를 등록해야 지도가 정상 로드됨.
KAKAO_NATIVE_APP_KEY=

# 릴리즈 서명 키스토어 (android:prod 용)
# 미설정 시 ~/.android/debug.keystore 자동 사용
# KEYSTORE_PATH=../release.keystore
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
